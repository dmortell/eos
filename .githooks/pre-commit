#!/bin/sh
# Pages tool gate (review.md §P5): when a commit touches CODE under src/routes/projects/[pid]/pages/, run its unit
# tests + a pages-scoped svelte-check (scripts/check-pages.mjs). Other commits are not affected — and neither is a
# commit that only changes docs there (*.md: todo, CHANGELOG, plans), which has nothing to check (Dave: too slow).
# Enabled per clone with:  git config core.hooksPath .githooks
if git diff --cached --name-only | grep '^src/routes/projects/\[pid\]/pages/' | grep -qv '\.md$'; then
	pnpm run --silent check:pages || { echo "pre-commit: the Pages gate failed — see above."; exit 1; }
fi
